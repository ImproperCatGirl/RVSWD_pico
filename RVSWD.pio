.program rvswd_io
.side_set 1
.define public CLK_DELAY 7 ;

public write_bits:

    mov pins, null side 1
    pull block side 1          ; Get bit count (N-1)
    mov x, osr side 1          ; Store in X
    pull block side 1          ; Get data word
    nop side 1 [CLK_DELAY]
do_write:
    out pindirs, 1 side 0 [CLK_DELAY]  ; CLK=0, SWDIO dir (1=output low, 0=input high)
    nop side 1 [CLK_DELAY]             ; CLK=1
    jmp x-- do_write side 1    ; Loop X+1 times
    irq 0 side 1               ; Signal completion
    jmp write_bits side 1

public read_bits:
    pull block side 1          ; Get bit count (N-1)
    mov x, osr side 1          ; Store in X
    nop side 1 [CLK_DELAY]
do_read:
    set pindirs, 0 side 0 [CLK_DELAY]  ; CLK=0, SWDIO input
    in pins, 1 side 1 [CLK_DELAY]      ; CLK=1, sample SWDIO
    jmp x-- do_read side 1     ; Loop X+1 times
    push side 1                ; Push ISR to RX FIFO
    irq 1 side 1               ; Signal completion
    jmp write_bits side 1