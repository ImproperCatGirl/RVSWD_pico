
.program rvswd_io
.side_set 1 opt

.define public BIT_DELAY 2

; RVSWD protocol implementation informed by:
; - https://github.com/aappleby/picorvd
; - https://github.com/Nicolai-Electronics/esp32-component-rvswd

; --- Command Dispatcher (Entry Point) ---
; Waits here for a command from the CPU
.wrap_target
public get_next_cmd:
    pull                side 1 ; Pull command, CLK idle high
    ; Command format: | 13:9 (Cmd Addr) | 8 (Dir) | 7:0 (Count-1) |
    out x, 8            ; Get bit count (X)
    out pindirs, 1      ; Get direction (1=write, 0=read)
    out pc, 5           ; Jump to command address
        
; --- Write Bits (Push Pull) ---
; X-reg = bit count-1
; 'Dir' bit must be 1 (write)
public write_bits:
    pull               ; 
write_bitloop:
    out pins, 1  side 0 [BIT_DELAY] ; CLK=0. Send data
    nop             side 1 [BIT_DELAY] ; CLK=1. Hold.
    jmp x-- write_bitloop
    jmp get_next_cmd
; Fall through to get_next_cmd

; --- Read Bits ---
; X-reg = bit count-1
; 'Dir' bit must be 0 (read)
read_bitloop_entry:
    nop side 1
public read_bits:
    nop  side 0 [BIT_DELAY] ; 
    in pins, 1      side 1 [BIT_DELAY] ; 
    jmp x-- read_bits         ; 
    push            ; 
    jmp get_next_cmd

; --- Special Sequences ---
public start:
    set pins, 1  side 1 [BIT_DELAY] ; SWDIO=H, CLK=H, wait 1us
    set pins, 0  side 1 [BIT_DELAY] ; SWDIO=L, CLK=H, wait 1us
    jmp get_next_cmd
; Fall through to get_next_cmd

public stop: 
    set pins, 0  side 1 [BIT_DELAY] ; SWDIO=L, CLK=H, wait 1us
    set pins, 1  side 1 [BIT_DELAY] ; SWDIO=H, CLK=H, wait 1us
    set pindirs, 0
    jmp get_next_cmd
; Fall through to get_next_cmd

public reset:
    set pins, 1  side 1 [BIT_DELAY] ; SWDIO=H
reset_loop:
    nop             side 0 [BIT_DELAY]
    nop             side 1 [BIT_DELAY]
    jmp x-- reset_loop
    jmp stop            ; Jump to stop sequence
; 'stop' will fall through to get_next_cmd
.wrap
